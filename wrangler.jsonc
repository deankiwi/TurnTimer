{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turntimer",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "routes": [
    { "pattern": "timer.deanw.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application", // serves index.html for /l/:id
    "run_worker_first": ["/ws", "/healthz"] // so SPA fallback never swallows these
  },
  // Per-IP cap on new WebSocket connections (join, create, reconnect).
  // Generous so a whole household or venue behind one IP can still play.
  "ratelimits": [
    { "name": "WS_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }]
}
